rules_version = '2';
// 百宏文教 bhcs-system — Firestore 安全規則
// 貼到 Firebase 主控台：Firestore Database → 規則 → 全部取代 → 發布
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    // 主管：固定帳號 admin@bhcs.local（由登入頁「建立主管帳號」建立），或 admins/{uid} 列出的備援主管（真實 Email）
    function isAdmin()  { return signedIn() && (request.auth.token.email == 'admin@bhcs.local' || exists(/databases/$(db)/documents/admins/$(request.auth.uid))); }
    // 老師：Auth 使用者必須有對應的 teachers/{uid} 文件；被主管刪除或重設密碼後舊登入即失效
    function isTeacher(){ return signedIn() && exists(/databases/$(db)/documents/teachers/$(request.auth.uid)); }
    function me()       { return get(/databases/$(db)/documents/teachers/$(request.auth.uid)).data.userId; }
    function isStaff()  { return isAdmin() || isTeacher(); }

    // 登入前的帳號查詢：只能用精確 userId 取單筆，不能列舉
    match /logins/{userId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // 備援主管帳號清單（主要主管建立；備援主管登入時 get 自己那筆）
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 老師名單（只有姓名與帳號，沒有密碼）
    //   老師只能把自己的 mustChangePassword 改成 false（改完密碼後）
    match /teachers/{uid} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isTeacher() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword','updatedAt'])
        && request.resource.data.mustChangePassword == false);
    }

    // 名冊快照（匯入前自動保存）：只有主管
    match /ctSnapshots/{id} { allow read, write: if isAdmin(); }

    // 電訪學生名冊（含家長電話）
    //   讀：主管全部；老師只能讀「配對給自己」的學生
    //   新增：老師可新增，但必須只配對給自己
    //   修改：老師只能 (a) 改基本資料（姓名/電話/班別），不能動別人的配對
    //                 (b) 把自己從配對移除
    //   刪除：只有主管
    function ctKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    match /ctStudents/{id} {
      allow read: if isAdmin() || (isTeacher() && me() in resource.data.teacherIds);
      allow create: if isAdmin() || (isTeacher()
        && request.resource.data.teacherIds == [me()]
        && request.resource.data.get('classTeachers', {}).values().hasOnly([me()]));
      allow update: if isAdmin() || (isTeacher() && me() in resource.data.teacherIds && (
        // (a) 編輯基本資料：配對不變；班別→老師對應只能保留原有的或加上自己
        ( ctKeys().hasOnly(['name','english','phones','sourceClasses','classTeachers','updatedAt'])
          && request.resource.data.teacherIds == resource.data.teacherIds
          && request.resource.data.get('classTeachers', {}).values()
               .hasOnly(resource.data.get('classTeachers', {}).values().concat([me()])) )
        ||
        // (b) 移除自己：teacherIds 只少了自己、classTeachers 只少了自己的項目
        ( ctKeys().hasOnly(['teacherIds','classTeachers','active','updatedAt'])
          && !(me() in request.resource.data.teacherIds)
          && request.resource.data.teacherIds.hasAll(resource.data.teacherIds.removeAll([me()]))
          && request.resource.data.teacherIds.size() == resource.data.teacherIds.size() - 1
          && !(me() in request.resource.data.get('classTeachers', {}).values())
          && resource.data.get('classTeachers', {}).values().removeAll([me()])
               .hasAll(request.resource.data.get('classTeachers', {}).values()) )
      ));
      allow delete: if isAdmin();
    }

    // 電訪紀錄：老師只能讀寫自己的；主管全權
    match /contacts/{id} {
      allow read:   if isAdmin() || (isTeacher() && resource.data.teacherId == me());
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherId == me());
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == me() && request.resource.data.teacherId == me()
        // 「已處理」標記只有主管能設；老師重新勾選／取消旗標時只能清成 null
        && (request.resource.data.get('flagResolvedAt', null) == null || request.resource.data.get('flagResolvedAt', null) == resource.data.get('flagResolvedAt', null)));
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == me());
    }

    // 教室日誌相關集合：登入的職員皆可讀寫（維持舊版行為，但擋掉所有匿名存取）
    match /classes/{id}        { allow read, write: if isStaff(); }
    match /entries/{id}        { allow read, write: if isStaff(); }
    match /scheduleSets/{id}   { allow read, write: if isStaff(); }
    match /scheduleConfig/{id} { allow read, write: if isStaff(); }
    match /schedule/{id}       { allow read, write: if isStaff(); }
    match /closures/{id}       { allow read, write: if isStaff(); }
    match /tasks/{id}          { allow read, write: if isStaff(); }
    match /taskSubs/{id}       { allow read, write: if isStaff(); }
    match /taskPhotos/{id}     { allow read, write: if isStaff(); }
    match /archives/{id}       { allow read, write: if isAdmin(); }
    match /archiveChunks/{id}  { allow read, write: if isAdmin(); }
  }
}
